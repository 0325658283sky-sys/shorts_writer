# Builds frontend/ for production. Needs the repo root as build context because
# frontend/src imports remotion/src directly via the "@new-cut/remotion" alias
# (see frontend/vite.config.ts) — Railway's per-service "Root Directory" would
# otherwise scope the build to frontend/ alone and that import would fail.
FROM node:20-slim AS build
WORKDIR /repo

COPY frontend/package.json frontend/package-lock.json frontend/
RUN cd frontend && npm ci

COPY frontend frontend
COPY remotion/src remotion/src

# remotion/src/*.tsx are type-checked as their own files (frontend/tsconfig.json
# includes them directly), so Node/TS module resolution walks up from
# remotion/src/ looking for node_modules to find the "react"/"remotion" type
# declarations. We only copied remotion/src (no remotion/node_modules), so
# without this symlink every file in there fails with "Cannot find module".
RUN ln -s /repo/frontend/node_modules /repo/remotion/node_modules

WORKDIR /repo/frontend
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM node:20-slim
WORKDIR /app
COPY --from=build /repo/frontend/dist ./dist
COPY --from=build /repo/frontend/node_modules/serve ./node_modules/serve

EXPOSE 3000
CMD ["sh", "-c", "node node_modules/serve/build/main.js -s dist -l ${PORT:-3000}"]
