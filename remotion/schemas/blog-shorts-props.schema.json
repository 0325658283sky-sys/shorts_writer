{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://new-cut.local/schemas/blog-shorts-props.json",
  "title": "BlogShortsProps",
  "description": "Shared Remotion BlogShorts input contract (R1). Backend and remotion/ must stay in sync.",
  "type": "object",
  "additionalProperties": false,
  "required": ["boards"],
  "properties": {
    "blogClipId": { "type": ["integer", "null"], "minimum": 1 },
    "title": { "type": ["string", "null"] },
    "styleTitle": {
      "type": ["string", "null"],
      "description": "Top title. Wrap accent words in *like this*."
    },
    "styleSubtitle": { "type": ["string", "null"] },
    "transitionSec": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.35 },
    "transitionType": {
      "type": "string",
      "enum": ["fade", "none", "slide"],
      "default": "fade"
    },
    "source": {
      "type": "string",
      "enum": ["dummy", "blog_clip"],
      "default": "dummy"
    },
    "narrationUrl": {
      "type": ["string", "null"],
      "description": "Full TTS+BGM mix: http(s) URL or path relative to remotion/public for staticFile()"
    },
    "visualStyle": {
      "type": ["string", "null"]
    },
    "style": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "layout": {
          "type": "string",
          "enum": ["fullscreen", "letterbox", "header_stack", "card"]
        },
        "mediaFit": { "type": "string", "enum": ["cover", "contain"] },
        "canvasBg": { "type": "string" },
        "caption": {
          "type": "string",
          "enum": ["center_stroke", "bottom_outline", "black_box", "white_pill"]
        },
        "header": {
          "type": "string",
          "enum": ["none", "info_black", "info_navy", "viral_cyan", "card_white"]
        },
        "titleColor": { "type": "string" },
        "accent": { "type": "string" },
        "transitionSec": { "type": "number", "minimum": 0, "maximum": 2 },
        "transitionType": { "type": "string", "enum": ["fade", "none", "slide"] },
        "kenBurns": { "type": "boolean" },
        "captionAnimation": { "type": "string", "enum": ["none", "highlight"] }
      }
    },
    "overlay": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "titleFont": {
          "type": "string",
          "enum": ["pretendard", "paperlogy", "gmarket_sans", "suit", "jalnan"]
        },
        "captionFont": {
          "type": "string",
          "enum": ["pretendard", "paperlogy", "gmarket_sans", "suit", "jalnan"]
        },
        "captionAnimation": { "type": "string", "enum": ["none", "highlight"] },
        "title": { "$ref": "#/$defs/overlayLayer" },
        "subtitle": { "$ref": "#/$defs/overlayLayer" },
        "caption": { "$ref": "#/$defs/overlayLayer" }
      }
    },
    "suppressText": { "type": "boolean" },
    "boards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/board" }
    }
  },
  "$defs": {
    "overlayLayer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "fontSize": { "type": "integer", "minimum": 16, "maximum": 140 },
        "color": { "type": "string" },
        "align": { "type": "string", "enum": ["left", "center", "right"] },
        "maxWidth": { "type": "number", "minimum": 0.2, "maximum": 1 },
        "visible": { "type": "boolean" }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "durationSec"],
      "properties": {
        "boardId": { "type": ["integer", "null"], "minimum": 1 },
        "imageUrl": {
          "type": ["string", "null"],
          "description": "http(s) URL or path relative to remotion/public for staticFile()"
        },
        "animated": {
          "type": "boolean",
          "description": "True for animated GIF boards (needed when imageUrl has no .gif suffix)"
        },
        "text": { "type": "string" },
        "durationSec": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "startSec", "endSec"],
            "properties": {
              "text": { "type": "string" },
              "startSec": { "type": "number" },
              "endSec": { "type": "number" }
            }
          }
        },
        "backgroundColor": { "type": ["string", "null"] },
        "speaker": { "type": ["string", "null"] }
      }
    }
  }
}
